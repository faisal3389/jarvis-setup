# Copy this file to .env.local (git-ignored) and fill in what you need. Everything is optional.
# The server reads .env.local on start (Node 20.12+). Without it Jarvis uses the browser's own voice.

# ElevenLabs key for the Jarvis voice (text to speech) and speech to text. Optional.
# Easiest: run `npx -y @elevenlabs/cli@latest onboard init` in this folder, or paste a key here.
ELEVENLABS_API_KEY=

# Optional server settings. Uncomment a line to change it (defaults shown).
# Port of the local server (http://127.0.0.1:4777/)
# JARVIS_PORT=4777
# Jarvis brain model: one short Claude run per sentence you say
# JARVIS_BRAIN_MODEL=haiku
# Manager model: plans the work, dispatches the workers, reviews their output
# JARVIS_MANAGER_MODEL=sonnet
# How many Manager runs at once (more wait in a queue)
# JARVIS_MAX_MANAGERS=2
# How many Jarvis brain runs at once
# JARVIS_MAX_BRAINS=3
# Manager timeout in milliseconds (15 minutes)
# JARVIS_MANAGER_TIMEOUT_MS=900000
# Jarvis brain timeout in milliseconds
# JARVIS_BRAIN_TIMEOUT_MS=45000
# ElevenLabs voice and model
# JARVIS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# JARVIS_TTS_MODEL=eleven_flash_v2_5
# Path to the Claude Code CLI if `claude` is not on PATH
# JARVIS_CLAUDE_BIN=claude
