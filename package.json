{
  "name": "jarvis-demo",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "A local voice 'personal Jarvis' demo: a Jarvis page, a Claude Code Manager and Claude Code workers (listed in workers.json) on mock data.",
  "scripts": {
