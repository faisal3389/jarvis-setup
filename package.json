    "setup": "bash bin/setup.sh",
    "reset": "bash bin/reset.sh",
    "test": "node tests/run-all.mjs",
    "agent": "bash bin/agent.sh",
    "restart": "bash bin/restart-server.sh"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.77.0"
  },
  "devDependencies": {
    "playwright": "^1.65.0"
  }
}
